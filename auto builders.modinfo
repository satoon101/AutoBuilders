<?xml version="1.0" encoding="utf-8"?>
<Mod id="9cb1621b-225b-412f-84d0-31196e9fd795" version="1">
    <Properties>
        <Name>Auto Builders</Name>
        <Description>Builders automatically move and create specific improvements.</Description>
        <Teaser>Auto-Build improvements</Teaser>
        <Authors>satoon101</Authors>
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>

    <InGameActions>

        <AddUserInterfaces id="AutoBuilderUI">
            <Properties>
                <Context>InGame</Context>
            </Properties>
            <File>scripts/UI/AutoBuilder_UI.xml</File>
        </AddUserInterfaces>

        <AddGameplayScripts id="AutoBuilderScript">
            <File>scripts/Gameplay/AutoBuilder.lua</File>
        </AddGameplayScripts>

        <ImportFiles id="AutoBuilderHelpers">
            <File>scripts/UI/AutoBuilder_Actions.lua</File>
            <File>scripts/UI/AutoBuilder_Constants.lua</File>
            <File>scripts/UI/AutoBuilder_Managers.lua</File>
        </ImportFiles>

    </InGameActions>

    <Files>
        <File>scripts/Gameplay/AutoBuilder.lua</File>
        <File>scripts/UI/AutoBuilder_UI.lua</File>
        <File>scripts/UI/AutoBuilder_UI.xml</File>
        <File>scripts/UI/AutoBuilder_Actions.lua</File>
        <File>scripts/UI/AutoBuilder_Constants.lua</File>
        <File>scripts/UI/AutoBuilder_Managers.lua</File>
    </Files>
</Mod>
